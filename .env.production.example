# Application runtime configuration
NODE_ENV=production
PORT=3000

# Database (recommended: PostgreSQL in production)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/core_service_prod?schema=public"

# JWT / session secrets
JWT_SECRET="CHANGE_ME_TO_A_STRONG_32_PLUS_CHAR_SECRET"
REFRESH_TOKEN_SECRET="CHANGE_ME_TO_A_DIFFERENT_STRONG_32_PLUS_CHAR_SECRET"
ENCRYPTION_KEY="CHANGE_ME_TO_A_64_CHAR_HEX_KEY_32_BYTES"

# Frontend application URL
APP_URL="https://your-domain.com"
CORS_ORIGIN="https://your-domain.com"

# Optional AI / external API
GEMINI_API_KEY=""

# Prisma (optional, only if you use a custom CLI target)
# PRISMA_SCHEMA_PATH="./prisma/schema.prisma"
