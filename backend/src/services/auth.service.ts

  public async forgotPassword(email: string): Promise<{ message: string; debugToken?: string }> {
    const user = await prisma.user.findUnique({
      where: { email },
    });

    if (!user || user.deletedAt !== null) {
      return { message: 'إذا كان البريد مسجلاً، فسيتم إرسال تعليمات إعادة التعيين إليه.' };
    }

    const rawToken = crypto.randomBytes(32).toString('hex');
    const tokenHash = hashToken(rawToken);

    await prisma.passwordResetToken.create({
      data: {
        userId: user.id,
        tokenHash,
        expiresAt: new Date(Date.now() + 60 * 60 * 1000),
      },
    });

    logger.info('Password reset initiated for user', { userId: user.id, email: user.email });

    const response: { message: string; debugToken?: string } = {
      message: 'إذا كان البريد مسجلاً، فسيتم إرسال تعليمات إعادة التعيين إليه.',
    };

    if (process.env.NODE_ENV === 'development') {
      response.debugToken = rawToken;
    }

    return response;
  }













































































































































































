import { prisma } from '../config/prisma';
import { hashPassword } from '../utils/password';
import { AppError } from '../utils/appError';
import { InstallSetupInput } from '../schemas/install.schema';
import { seed } from '../../prisma/seed';
import { logger } from '../utils/logger';

export class InstallService {
  public async getInstallationStatus(): Promise<{ isInstalled: boolean; installedAt?: string }> {
    const superAdminRole = await prisma.role.findUnique({
      where: { slug: 'super_admin' },
    });

    if (!superAdminRole) {
      return { isInstalled: false };
    }

    const admin = await prisma.user.findFirst({
      where: { roleId: superAdminRole.id, deletedAt: null },
      select: { createdAt: true },
    });

    return {
      isInstalled: !!admin,
      installedAt: admin ? admin.createdAt.toISOString() : undefined,
    };
  }

  public async setupInitialSystem(input: InstallSetupInput): Promise<{ success: boolean; message: string }> {
    const status = await this.getInstallationStatus();
    if (status.isInstalled) {
      throw new AppError(
        'نظام Enterprise مثبت مسبقاً. تم إغلاق معالج التنصيب لأسباب أمنية.',
        403,
        'SYSTEM_ALREADY_INSTALLED'
      );
    }

    logger.info('Starting initial enterprise installation transaction...');

    await seed();

    const superAdminRole = await prisma.role.findUnique({
      where: { slug: 'super_admin' },
    });

    if (!superAdminRole) {
      throw new AppError('فشل تهيئة الأدوار الأساسية في النظام', 500, 'ROLE_INITIALIZATION_FAILED');
    }

    const passwordHash = await hashPassword(input.adminPassword);

    await prisma.$transaction(async (tx) => {
      await tx.user.upsert({
        where: { email: input.adminEmail },
        update: {
          firstName: input.adminFirstName,
          lastName: input.adminLastName,
          phone: input.adminPhone,
          passwordHash,
          roleId: superAdminRole.id,
          status: 'ACTIVE',
          emailVerifiedAt: new Date(),
        },
        create: {
          email: input.adminEmail,
          firstName: input.adminFirstName,
          lastName: input.adminLastName,
          phone: input.adminPhone,
          passwordHash,
          roleId: superAdminRole.id,
          status: 'ACTIVE',
          emailVerifiedAt: new Date(),
        },
      });

      await tx.systemSetting.upsert({
        where: { key: 'general.site_name' },
        update: { value: input.siteName },
        create: {
          key: 'general.site_name',
          value: input.siteName,
          group: 'general',
          description: 'اسم المنصة العام',
        },
      });

      await tx.systemSetting.upsert({
        where: { key: 'general.site_url' },
        update: { value: input.siteUrl },
        create: {
          key: 'general.site_url',
          value: input.siteUrl,
          group: 'general',
          description: 'الرابط الأساسي للموقع',
        },
      });

      await tx.systemSetting.upsert({
        where: { key: 'general.admin_email' },
        update: { value: input.adminEmail },
        create: {
          key: 'general.admin_email',
          value: input.adminEmail,
          group: 'general',
          description: 'البريد الرسمي للدعم',
        },
      });

      await tx.auditLog.create({
        data: {
          action: 'SYSTEM_INSTALL',
          module: 'install',
          details: JSON.stringify({
            siteName: input.siteName,
            adminEmail: input.adminEmail,
            timestamp: new Date().toISOString(),
          }),
        },
      });
    });

    logger.info('Enterprise installation completed successfully.');

    return {
      success: true,
      message: 'تم تنصيب وتهيئة نظام Enterprise بنجاح. يمكنك الآن تسجيل الدخول.',
    };
  }
}

export const installService = new InstallService();































































































































